# Shared
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-long-random-value
JWT_REFRESH_SECRET=replace-with-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Azure
AZURE_REGION=westus2
AZURE_REGION_FALLBACK=westus3
AZURE_RESOURCE_GROUP=garbagepailpals

# Database (Azure-hosted PostgreSQL)
DATABASE_URL=postgresql://postgres:password@your-server.postgres.database.azure.com:5432/garbage_pail_pals?schema=public&sslmode=require
DIRECT_URL=postgresql://postgres:password@your-server.postgres.database.azure.com:5432/garbage_pail_pals?schema=public&sslmode=require

# API
API_PORT=7071
WEB_ORIGIN=http://localhost:5173
DEV_FAKE_ENTITLEMENT=true
SCHEDULER_LOOKAHEAD_DAYS=14

# Payments (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
