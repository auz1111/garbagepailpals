{
  "name": "@gpp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && pnpm exec esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --external:@azure/functions --external:@prisma/client --external:prisma --external:@prisma/engines",
    "dev": "func start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@azure/functions": "^4.6.0",
    "@gpp/db": "workspace:*",
    "@gpp/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.3",
    "luxon": "^3.5.0",
    "stripe": "^16.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.6.2",
    "esbuild": "^0.28.1",
    "vitest": "^2.0.5"
  }
}
