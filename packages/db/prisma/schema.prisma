generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  OPERATOR
  ADMIN
}

enum Cadence {
  WEEKLY
  BIWEEKLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum EntitlementSource {
  STRIPE
  PAYPAL
  REVENUECAT
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  CANCELED
  PAUSED
}

enum ServiceJobType {
  CURB_OUT
  CURB_IN
}

enum ServiceJobStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  FAILED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  phone                String?
  name                 String
  role                 UserRole
  authProviderId       String?
  passwordHash         String?
  stripeCustomerId     String?
  paypalPayerId        String?
  revenueCatAppUserId  String?
  requestedServiceArea String?
  operatorAccess       Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  serviceAddresses     ServiceAddress[]
  subscriptions        Subscription[]
  entitlements         Entitlement[]
  assignedJobs         ServiceJob[]   @relation("AssignedOperatorJobs")
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]     @relation("AuditActorLogs")
  availability         OperatorAvailability[]
}

model OperatorAvailability {
  id         String   @id @default(cuid())
  operatorId String
  date       DateTime @db.Date
  createdAt  DateTime @default(now())
  operator   User     @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([operatorId, date])
  @@index([date])
}

model ServiceAddress {
  id               String            @id @default(cuid())
  userId           String
  line1            String
  line2            String?
  city             String
  state            String
  postalCode       String
  lat              Decimal           @db.Decimal(9, 6)
  lng              Decimal           @db.Decimal(9, 6)
  timezone         String
  accessNotes      String
  gateCode         String?
  canCount         Int               @default(2)
  pickupsPerWeek   Int               @default(1)
  rollIn           Boolean           @default(true)
  isActive         Boolean           @default(true)
  neighborhoodId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  neighborhood     Neighborhood?     @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  schedules        ServiceSchedule[]
  subscriptions    Subscription[]
  jobs             ServiceJob[]
  holds            ServiceHold[]

  @@index([postalCode])
  @@index([userId])
  @@index([neighborhoodId])
}

model Neighborhood {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  addresses ServiceAddress[]
}

model ServiceSchedule {
  id                  String         @id @default(cuid())
  serviceAddressId    String
  pickupDayOfWeek     Int
  cadence             Cadence        @default(WEEKLY)
  biweeklyAnchorDate  DateTime?
  canCount            Int            @default(2)
  rollIn              Boolean        @default(true)
  curbOutOffsetHours  Int            @default(-12)
  curbInOffsetHours   Int            @default(8)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  serviceAddress      ServiceAddress @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  @@unique([serviceAddressId, pickupDayOfWeek])
  @@index([serviceAddressId])
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  serviceAddressId       String
  planId                 String?
  source                 String?
  externalSubscriptionId String?
  amountCents            Int?
  status                 SubscriptionStatus
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceAddress         ServiceAddress     @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: Restrict)
  jobs                   ServiceJob[]

  @@unique([userId, serviceAddressId])
  @@index([userId])
  @@index([serviceAddressId])
  @@index([status])
}

model Entitlement {
  id                      String             @id @default(cuid())
  userId                  String
  source                  EntitlementSource
  externalSubscriptionId  String
  status                  EntitlementStatus
  expiresAt               DateTime?
  rawPayload              Json
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalSubscriptionId])
  @@index([userId, status, expiresAt])
}

model Plan {
  id                          String          @id @default(cuid())
  code                        String          @unique
  name                        String
  description                 String
  priceCents                  Int
  interval                    PlanInterval
  stripePriceId               String?
  paypalPlanId                String?
  revenueCatEntitlementId     String?
  isActive                    Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  subscriptions               Subscription[]
}

model ServiceJob {
  id                  String           @id @default(cuid())
  serviceAddressId    String
  subscriptionId      String
  scheduledDate       DateTime
  type                ServiceJobType
  status              ServiceJobStatus
  assignedOperatorId  String?
  routeSequence       Int?
  completedAt         DateTime?
  photoBlobPath       String?
  failureReason       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  serviceAddress      ServiceAddress   @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)
  subscription        Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  assignedOperator    User?            @relation("AssignedOperatorJobs", fields: [assignedOperatorId], references: [id], onDelete: SetNull)

  @@unique([serviceAddressId, scheduledDate, type])
  @@index([status, scheduledDate])
}

model ServiceHold {
  id                String          @id @default(cuid())
  serviceAddressId  String
  startDate         DateTime
  endDate           DateTime
  reason            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceAddress    ServiceAddress  @relation(fields: [serviceAddressId], references: [id], onDelete: Cascade)

  @@index([serviceAddressId, startDate, endDate])
}

model HolidayCalendar {
  id              String    @id @default(cuid())
  region          String
  municipality    String
  date            DateTime
  shiftDays       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([municipality, date])
  @@index([region, date])
}

model ServiceArea {
  id          String    @id @default(cuid())
  postalCode  String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebhookEvent {
  id               String    @id @default(cuid())
  provider         String
  externalEventId  String
  payload          Json
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, externalEventId])
}

model AuditLog {
  id           String    @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  metadata     Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  actorUser    User?     @relation("AuditActorLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
